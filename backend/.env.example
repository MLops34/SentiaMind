# ──────────────────────────────────────────────
# SentiaMind Backend — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development
APP_NAME=SentiaMind
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentia:sentia_pass@localhost:5432/sentiamind

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AES-256 Encryption ────────────────────────
# MUST be exactly 64 hex chars (= 32 bytes when decoded)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# ── HuggingFace / ML ─────────────────────────
# Path to fine-tuned DistilBERT weights directory.
# Falls back to "j-hartmann/emotion-english-distilroberta-base" if not found.
HUGGINGFACE_MODEL_PATH=./models/distilbert-emotion

# ── CORS ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
